# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Dependency directories
vendor/

# Go workspace file
go.work

# Config files with sensitive information
backend/configs/config.yaml

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Node
frontend/node_modules/
frontend/dist/
.dev/

# Private local test data
testdata/private/*
!testdata/private/.gitkeep
!testdata/private/README.md
!testdata/private/*.example

# Public corpus eval runs (per-run reports, not committed)
testdata/i1/public_corpus/runs/*
!testdata/i1/public_corpus/runs/.gitkeep
